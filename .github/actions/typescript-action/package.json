{
  "name": "typescript-action",
  "version": "1.0.0",
  "description": "Example TypeScript Actions",
  "homepage": "https://github.com/cions/actions-playground",
  "license": "MIT",
  "author": "cions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cions/actions-playground.git"
  },
  "type": "module",
  "exports": {
    "./*": "./*"
  },
  "scripts": {
    "update": "npm exec --yes -- npm-check-updates --upgrade --target greatest --pre 0 --peer && npm audit fix && npm install",
    "fix": "eslint --fix",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint",
    "lint:tsc": "tsc --noEmit",
    "test": "jest",
    "build": "node build.js",
    "all": "run-s lint test build"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.9.0",
    "eslint-plugin-jest": "^29.16.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "npm-run-all2": "^9.0.3",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
